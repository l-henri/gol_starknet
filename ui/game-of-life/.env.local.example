# Copy to .env.local and fill in. Contract addresses live in the SDK's address book now —
# only the optional doors below need configuration.

# ---- Email login (Privy) — optional; the email door only appears when the app id is set ----
# Privy dashboard → your app → App ID (public, ships to the browser)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → Settings → App secret (SERVER ONLY — never commit, never paste in chat)
PRIVY_APP_SECRET=
# Optional: the app's token verification key (Privy dashboard → Settings). When unset,
# tokens are verified against Privy's public JWKS endpoint automatically — leave empty.
PRIVY_VERIFICATION_KEY=

# ---- Gas sponsorship (AVNU paymaster) ----
# AVNU portal API key (SERVER ONLY) — required for sponsored mode.
PAYMASTER_API_KEY=
# Lifetime sponsored-transaction cap per keeper account (enforced by nonce; default 25)
SPONSORED_TX_CAP=25

# ---- RPC overrides (optional; defaults go through the same-origin /api/rpc proxy) ----
# NEXT_PUBLIC_GOL_RPC_URL=
# NEXT_PUBLIC_GOL_RPC_URL_COMPAT=
# NEXT_PUBLIC_GOL_RPC_URL_V9=
